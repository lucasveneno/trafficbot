{
  "name": "@lucasveneno/trafficbot",
  "version": "2.0.1",
  "description": "Enterprise-grade stealth traffic generation framework.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasveneno/trafficbot.git"
  },
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "dev:engine": "npm run build && node dist/controller.js",
    "dev:desktop": "npm run build && npm --prefix apps/desktop run tauri -- dev",
    "build:desktop": "npm run build && node scripts/prepare-desktop-engine.cjs && npm --prefix apps/desktop run tauri -- build",
    "test:control": "RUN_CONTROL_TESTS=1 jest --runInBand ControlServer.test.ts",
    "worker": "BOT_ROLE=worker node dist/main.js",
    "worker:windows": "set BOT_ROLE=worker&& set WORKER_PLATFORM=windows&& node dist/main.js",
    "worker:macos": "BOT_ROLE=worker WORKER_PLATFORM=macos node dist/main.js",
    "worker:android": "BOT_ROLE=worker WORKER_PLATFORM=android node dist/main.js",
    "build:worker:linux": "bun build --compile --target=bun-linux-x64 ./src/main.ts --outfile dist/trafficbot-worker-linux",
    "build:worker:windows": "bun build --compile --target=bun-windows-x64 ./src/main.ts --outfile dist/trafficbot-worker-windows.exe",
    "build:worker:macos": "bun build --compile --target=bun-darwin-arm64 ./src/main.ts --outfile dist/trafficbot-worker-macos",
    "build:worker:all": "npm run build:worker:linux && npm run build:worker:windows && npm run build:worker:macos",
    "test": "jest",
    "lint": "eslint src",
    "download-browsers": "puppeteer browsers install chrome",
    "setup:linux": "bash scripts/setup-linux.sh",
    "run:examples": "bash scripts/run-examples.sh",
    "test:fingerprint": "ts-node scripts/test-fingerprint.ts",
    "audit:fingerprint": "ts-node scripts/audit-fingerprint.ts",
    "check:artifacts": "node scripts/check-artifacts.cjs",
    "test:browser": "RUN_BROWSER_TESTS=1 jest --runInBand PuppeteerStealthEngine.test.ts",
    "test:redis": "RUN_REDIS_TESTS=1 jest --runInBand QueueService.integration.test.ts",
    "test:campaigns": "RUN_REDIS_TESTS=1 jest --runInBand CampaignCapacity.integration.test.ts",
    "test:lifecycle": "npm run build && RUN_LIFECYCLE_TESTS=1 jest --runInBand lifecycle.integration.test.ts",
    "test:android": "RUN_ANDROID_TESTS=1 jest --runInBand Android.integration.test.ts",
    "release:verify": "node scripts/release-verify.cjs",
    "release:dry-run": "node scripts/release-dry-run.cjs",
    "version:check": "node scripts/version-check.cjs",
    "release:promote": "node scripts/release-promote.cjs"
  },
  "dependencies": {
    "bullmq": "^5.70.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.0",
    "minimist": "^1.2.8",
    "puppeteer": "^24.37.5",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "winston": "^3.10.0",
    "ws": "^8.22.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.4",
    "@types/minimist": "^1.2.2",
    "@types/node": "^20.5.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "jest": "^29.6.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "author": "Lucas Coelho de Oliveira Lima",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
